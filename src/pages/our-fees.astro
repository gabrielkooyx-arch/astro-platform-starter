---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Our Fees - WealthGuard">
    <h1 class="mb-10">Our Fees</h1>
    <p class="text-xl text-primary font-semibold mb-8">Transparent and Competitive Pricing</p>

    <section class="mb-16">
        <div class="overflow-x-auto">
            <table class="w-full border-collapse bg-gray-900/50 rounded-lg overflow-hidden">
                <thead>
                    <tr>
                        <th class="text-left p-4 font-bold border-b border-gray-700 underline">Fee Type</th>
                        <th class="text-left p-4 font-bold border-b border-gray-700 underline">Details</th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="border-b border-gray-700/50 hover:bg-gray-800/30 transition-colors">
                        <td class="p-4 font-medium">Initial Consultation</td>
                        <td class="p-4 text-green-400">Free of charge</td>
                    </tr>
                    <tr class="border-b border-gray-700/50 hover:bg-gray-800/30 transition-colors">
                        <td class="p-4 font-medium">Subsequent Consultation</td>
                        <td class="p-4">Please contact us for information</td>
                    </tr>
                    <tr class="hover:bg-gray-800/30 transition-colors">
                        <td class="p-4 font-medium">Performance-Based Fee</td>
                        <td class="p-4">Please contact us for information</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <p class="text-center mt-12">
        <a href="/contact-us" class="btn btn-lg sm:min-w-64">
            Contact Us Today
        </a>
    </p>
</Layout>
